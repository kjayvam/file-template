# 이 파일을 .env로 복사해서 값을 채우세요. (.env는 커밋하지 않습니다)
RUST_LOG=info
PORT=8080

# Vite 개발 서버의 /api 프록시 대상 (vite.config.ts가 프로세스 환경 변수로 읽음)
# 루트 .env는 Vite가 자동으로 읽지 않으므로 기본값(http://localhost:8080)과 다를 때만
# `VITE_API_BACKEND_URL=... npm run dev`처럼 지정합니다. 개발 Compose는 http://backend:8080을 지정합니다.
# VITE_API_BACKEND_URL=http://localhost:8080

# 데이터베이스 설정 (프로젝트 상황에 맞게 선택)
# 1) SQLite 사용 시 (단일 파일, 별도 DB 컨테이너 불필요)
DATABASE_URL=sqlite:///app/data/app.db

# 2) 서버형 데이터베이스(PostgreSQL, MySQL 등) 사용 시
# DATABASE_URL=postgres://my_project:change-me@localhost:5432/my_project
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=my_project
# DATABASE_USER=my_project
# DATABASE_PASSWORD=change-me
